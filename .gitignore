# IDE and environment
.idea/
.vscode/
.venv/
venv/
env/
*.swp
*.swo
*~

# Python build files
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/

# Data generated by the project
# Ignore generated numpy arrays and CSV outputs inside data/ and subfolders
data/**/*.npy
data/**/*.csv
# Keep original source CSVs for wine
!data/wine-quality/winequality-red.csv
!data/wine-quality/winequality-white.csv
!data/wine-quality/winequality.names
!data/concrete-strength/Concrete_Data.csv

# Trained models (ignore large/binary files in models/ directories)
models/**/*.h5
models/**/*.keras
models/**/*.pkl
models/**/*.weights.h5
# keep .gitkeep files if present
!models/.gitkeep

# Results and plots
results/*.png
results/*.json
results/*.txt
results/*.npy

# Temporary data and logs
*.log
*.tmp

# Other files typical for Python projects
.env
.DS_Store
.python-version

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# macOS file system
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
